aZ|sZ6oT,EnR"><field name="TEXT">The rain was refreshing</field></shadow></value><value name="ADD8"><shadow type="text" id="VQx]S!8;lmGM==nz3=yo"><field name="TEXT">Your painting is creative</field></shadow></value><value name="ADD9"><shadow type="text" id="S^K??.dm~lsD.~B7jOJ!"><field name="TEXT">They made a brave choice</field></shadow></value><value name="ADD10"><shadow type="text" id="3KHkk8(vP2!-lP|VLO_^"><field name="TEXT">This student is quick</field></shadow></value><value name="ADD11"><shadow type="text" id="8:k~!Mng+2WO}@iPDz]5"><field name="TEXT">She is a natural leader</field></shadow></value><value name="ADD12"><shadow type="text" id="CjM*b%DPJszE2|{Y^_UH"><field name="TEXT">This tree looks sturdy</field></shadow></value><value name="ADD13"><shadow type="text" id="9Qw(p,Z{(9+EYsRy@3C/"><field name="TEXT">The music was lively</field></shadow></value><value name="ADD14"><shadow type="text" id="^SB=omj,P)e6|Ja/IIl2"><field name="TEXT">This story is detailed</field></shadow></value><value name="ADD15"><shadow type="text" id="mQrcYmIJ:+yTA-6R.H`="><field name="TEXT">He has an assured smile</field></shadow></value><value name="ADD16"><shadow type="text" id="rkNApI0==vv*:{~{=u04"><field name="TEXT">The morning feels crisp</field></shadow></value><value name="ADD17"><shadow type="text" id="]O2,b3QI1r6[ejz7(ARb"><field name="TEXT">They play a competitive game</field></shadow></value><value name="ADD18"><shadow type="text" id="e|[HX{5_HV5KLC`qrMBQ"><field name="TEXT">The soil is moist</field></shadow></value><value name="ADD19"><shadow type="text" id="7s:mX)HoXix*R6Eg?l[O"><field name="TEXT">The speech was thorough</field></shadow></value><value name="ADD20"><shadow type="text" id="U3I3h_6Fzx1nT!)9|G7!"><field name="TEXT">Your haircut is modern</field></shadow></value><value name="ADD21"><shadow type="text" id="o$6,3V@3~lP2wIKpPBw?"><field name="TEXT">He keeps a private journal</field></shadow></value><value name="ADD22"><shadow type="text" id="FV*n{6rjaK-ZBmqK^P!B"><field name="TEXT">The puppy is playful</field></shadow></value><value name="ADD23"><shadow type="text" id="sGFjaZ3i;d]djmUG]~^:"><field name="TEXT">The watch is inexpensive</field></shadow></value><value name="ADD24"><shadow type="text" id=";Ndn0d[ffz%QIJojQXtt"><field name="TEXT">The party was memorable</field></shadow></value><value name="ADD25"><shadow type="text" id="k,}q/wPwbzvbU4J}~fIo"><field name="TEXT">He is diligent</field></shadow></value><value name="ADD26"><shadow type="text" id="EU56e.J51uX`I|[_=6S#"><field name="TEXT">The trail is challenging</field></shadow></value><value name="ADD27"><shadow type="text" id="oGgyK#Z]RX]m_%rs0],#"><field name="TEXT">He is thin</field></shadow></value><value name="ADD28"><shadow type="text" id="oo(Cv|-0Gz/F@,8$Wd^x"><field name="TEXT">She is sure of herself</field></shadow></value><value name="ADD29"><shadow type="text" id="pPv3^dZ*`$Fm2fdfxDXS"><field name="TEXT">He is relaxed</field></shadow></value><value name="ADD30"><shadow type="text" id="8*j7_hggzbIWnTZ10uc2"><field name="TEXT">She is frugal</field></shadow></value><value name="ADD31"><shadow type="text" id="sVROcfxzfOfd%cDW43}K"><field name="TEXT">The city is bustling</field></shadow></value><value name="ADD32"><shadow type="text" id=";?=(nqg.Uk?VAEAdN^W="><field name="TEXT">He is inquisitive</field></shadow></value><value name="ADD33"><shadow type="text" id="TR~r{aWO(eR)EtI)3+p?"><field name="TEXT">The plan is flexible</field></shadow></value><value name="ADD34"><shadow type="text" id="=8BTAH*l~s769!HxDu_q"><field name="TEXT">She believes in herself</field></shadow></value><value name="ADD35"><shadow type="text" id=":[!YJ/^s4xB^BNtNEU56"><field name="TEXT">The room is cozy</field></shadow></value><value name="ADD36"><shadow type="text" id=")5JaO%vY6eLN-VKMA@||"><field name="TEXT">He keeps trying</field></shadow></value><value name="ADD37"><shadow type="text" id="A:;ah=edILeDFr?0Q}nq"><field name="TEXT">The dog is loyal</field></shadow></value><value name="ADD38"><shadow type="text" id="qdUrv?AlbCMjvG/b`e4t"><field name="TEXT">She is honest</field></shadow></value><value name="ADD39"><shadow type="text" id="i/nveV{kGn(lN5qN8V)q"><field name="TEXT">The house is old-fashioned</field></shadow></value><value name="ADD40"><shadow type="text" id="xz!j{{I#._g@+[ky|xA?"><field name="TEXT">He is calm</field></shadow></value><value name="ADD41"><shadow type="text" id="i=VUHi$]C)-/Y+5{@sC-"><field name="TEXT">He is patient</field></shadow></value><value name="ADD42"><shadow type="text" id="_{!;K-Zm?kUJfVDaNoy1"><field name="TEXT">The joke is edgy</field></shadow></value><value name="ADD43"><shadow type="text" id="u7xLOqDJ[cN?VTj3`tRA"><field name="TEXT">The movie is intense</field></shadow></value><value name="ADD44"><shadow type="text" id="eEpICL[RM*#6?hbben$l"><field name="TEXT">He is lean</field></shadow></value><value name="ADD45"><shadow type="text" id="26_-Dm-6fP*FHj@s#Bg@"><field name="TEXT">The design is minimal</field></shadow></value><value name="ADD46"><shadow type="text" id="(V_4[nSnM8bGC=p5oF(/"><field name="TEXT">The neighborhood is peaceful</field></shadow></value><value name="ADD47"><shadow type="text" id="-A%Ieby5,SG?Vi^8KOO8"><field name="TEXT">He is generous</field></shadow></value><value name="ADD48"><shadow type="text" id="FRs/0z@A+aEq559Rw(@u"><field name="TEXT">The plan is bold</field></shadow></value><value name="ADD49"><shadow type="text" id="DPgP1[cx5:R=bCSF*p$R"><field name="TEXT">She speaks her mind</field></shadow></value><value name="ADD50"><shadow type="text" id="_(O=H3vyT1pmY)I:c=`%"><field name="TEXT">He is self-assured</field></shadow></value><value name="ADD51"><shadow type="text" id="+w`6:@KGsE1OmWiiPh=]"><field name="TEXT">She works hard</field></shadow></value><value name="ADD52"><shadow type="text" id="ERcPIJMk%c~xc?2}YuF5"><field name="TEXT">The food is rich</field></shadow></value><value name="ADD53"><shadow type="text" id="RAY5~tVR@k4@AS;R1P0w"><field name="TEXT">He saves money</field></shadow></value><value name="ADD54"><shadow type="text" id="{C;.S;lf?S=BtM{gl*J!"><field name="TEXT">The car is affordable</field></shadow></value><value name="ADD55"><shadow type="text" id="Z.(`K]+l~TJ!rXR4NF0="><field name="TEXT">She is cautious</field></shadow></value><value name="ADD56"><shadow type="text" id="Vor3^f{Eapcc}NA^`f^Z"><field name="TEXT">The room is compact</field></shadow></value><value name="ADD57"><shadow type="text" id="Oe7{k*;J|8M;*^7vwRTD"><field name="TEXT">He is spontaneous</field></shadow></value><value name="ADD58"><shadow type="text" id="oX]VcikY|KU{eW%#g9@d"><field name="TEXT">The fabric is soft</field></shadow></value><value name="ADD59"><shadow type="text" id="$pvBJcG`q.h05}TFvH_t"><field name="TEXT">She is sociable</field></shadow></value><value name="ADD60"><shadow type="text" id="Z)%?XSBq=e|yjkc3f*X~"><field name="TEXT">He is funny</field></shadow></value><value name="ADD61"><shadow type="text" id="+N-XxMp)=T/3vEi|X}7T"><field name="TEXT">She is graceful</field></shadow></value><value name="ADD62"><shadow type="text" id=".0Y8k9R,clG8`.A^HkQ1"><field name="TEXT">The garden is thriving</field></shadow></value><value name="ADD63"><shadow type="text" id="5s!o0kjrK4jXFh?`vSHI"><field name="TEXT">He notices things</field></shadow></value><value name="ADD64"><shadow type="text" id="MeD|O#F2;L}SGGneL55f"><field name="TEXT">The coffee is strong</field></shadow></value><value name="ADD65"><shadow type="text" id="^^3aj*|;q#@2wR[3:;*%"><field name="TEXT">She is caring</field></shadow></value><value name="ADD66"><shadow type="text" id="oUWX1aib8E(at-yS[xg?"><field name="TEXT">The path is winding</field></shadow></value><value name="ADD67"><shadow type="text" id="Ej=;Wh7PD2zs.qJGO_8l"><field name="TEXT">He is resourceful</field></shadow></value><value name="ADD68"><shadow type="text" id="U*368t;zDTe;S;inZ._B"><field name="TEXT">The city is vibrant</field></shadow></value><value name="ADD69"><shadow type="text" id="lI(I,L;0(]keS+Q`/WVp"><field nam